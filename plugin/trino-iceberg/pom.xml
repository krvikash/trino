    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <configuration>
                        <ignoredNonTestScopedDependencies>
                            <ignoredNonTestScopedDependency>org.apache.parquet:parquet-common</ignoredNonTestScopedDependency>
                            <ignoredNonTestScopedDependency>software.amazon.awssdk:aws-core</ignoredNonTestScopedDependency>
                            <ignoredNonTestScopedDependency>software.amazon.awssdk:utils</ignoredNonTestScopedDependency>
                        </ignoredNonTestScopedDependencies>
                    </configuration>
                    <executions>
                        <execution>
                            <id>copy</id>
                            <goals>
                                <goal>copy</goal>
                            </goals>
                            <phase>process-test-resources</phase>
                            <configuration>
                                <skip>false</skip>
                                <artifactItems>
                                    <artifactItem>
                                        <groupId>org.apache.ozone</groupId>
                                        <artifactId>ozone-filesystem-hadoop3</artifactId>
                                        <version>1.4.0</version>
                                        <type>jar</type>
                                        <outputDirectory>${project.build.directory}</outputDirectory>
                                    </artifactItem>
                                </artifactItems>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
                <configuration>
                    <ignoredResourcePatterns combine.children="append">
                        <!-- com.google.protobuf:protobuf-java and com.databricks:databricks-jdbc proto file duplicate -->
                        <ignoredResourcePattern>google/protobuf/.*\.proto$</ignoredResourcePattern>
                        <!-- com.databricks.jdbc:databricks-sdk-java and com.databricks:databricks-jdbc file duplicate -->
                        <ignoredResourcePattern>oauth/failed_response.html.tmpl</ignoredResourcePattern>
                        <ignoredResourcePattern>oauth/successful_response.html</ignoredResourcePattern>
                        <!-- org.apache.commons:commons-configuration2 and com.databricks:databricks-jdbc file duplicate -->
                        <ignoredResourcePattern>PropertyList-1.0.dtd</ignoredResourcePattern>
                        <ignoredResourcePattern>properties.dtd</ignoredResourcePattern>
                        <!-- Conflicts between com.cronutils:cron-utils:9.2.0 and org.openjdk.jmh:jmh-core:1.37 -->
                        <ignoredResourcePattern>checkstyle.xml</ignoredResourcePattern>
                        <ignoredResourcePattern>iceberg-build.properties</ignoredResourcePattern>
                        <ignoredResourcePattern>mozilla/public-suffix-list.txt</ignoredResourcePattern>
                        <ignoredResourcePattern>mime.types</ignoredResourcePattern>
                        <ignoredResourcePattern>org/conscrypt/conscrypt.properties</ignoredResourcePattern>
                        <!-- com.databricks:databricks-jdbc:2.7.1, org.apache.logging.log4j:log4j-api -->
                        <ignoredResourcePattern>Log4j-charsets.properties</ignoredResourcePattern>
                        <!-- Duplicate in test classpath: trino-iceberg/target/test-classes and trino-hive:tests -->
                        <ignoredResourcePattern>ozone-filesystem-hadoop3-1.4.0.jar</ignoredResourcePattern>
                    </ignoredResourcePatterns>
                    <ignoredClassPatterns>
                        <ignoredClassPattern>org.conscrypt.*</ignoredClassPattern>
                        <!-- com.google.protobuf:protobuf-java and org.apache.ozone:ozone-filesystem-hadoop3-client both ship PluginProtos -->
                        <ignoredClassPattern>com\.google\.protobuf\.compiler\.PluginProtos.*</ignoredClassPattern>
                    </ignoredClassPatterns>
                </configuration>
            </plugin>
        </plugins>
    </build>

