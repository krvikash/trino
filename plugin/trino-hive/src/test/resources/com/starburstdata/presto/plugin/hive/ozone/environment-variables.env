# https://github.com/apache/ozone/blob/master/hadoop-ozone/dist/src/main/compose/ozonesecure/docker-config
CORE-SITE.XML_fs.defaultFS=ofs://ozone-manager
CORE-SITE.XML_hadoop.security.authentication=simple
CORE-SITE.XML_hadoop.security.authorization=false
CORE-SITE.XML_hadoop.proxyuser.hive.hosts=*
CORE-SITE.XML_hadoop.proxyuser.hive.groups=*

OZONE-SITE.XML_ozone.om.address=ozone-manager
OZONE-SITE.XML_ozone.om.http-address=ozone-manager:9874
OZONE-SITE.XML_ozone.scm.names=storage-container-manager
OZONE-SITE.XML_ozone.scm.datanode.id.dir=/data
OZONE-SITE.XML_ozone.scm.block.client.address=storage-container-manager
OZONE-SITE.XML_ozone.metadata.dirs=/data/metadata
OZONE-SITE.XML_ozone.scm.client.address=storage-container-manager
OZONE-SITE.XML_ozone.scm.client.address=storage-container-manager
OZONE-SITE.XML_hdds.datanode.dir=/data/hdds
OZONE-SITE.XML_ozone.recon.db.dir=/data/metadata/recon
OZONE-SITE.XML_ozone.recon.address=recon:9891
# For supporting legacy S3
OZONE-SITE.XML_ozone.s3g.list-keys.shallow.enabled=false
no_proxy=ozone-manager,recon,storage-container-manager,s3-gateway,localhost,127.0.0.1
