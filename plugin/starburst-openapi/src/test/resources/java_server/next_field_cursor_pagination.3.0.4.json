{
    "openapi": "3.0.4",
    "info": {
        "title": "Metadata Next Field Cursor Pagination API",
        "version": 1.0,
        "description": "Specification for testing the METADATA_NEXT_FIELD_CURSOR pagination strategy. The cursor for the next page is embedded as a field in the JSON response body."
    },
    "paths": {
        "/items/cursor": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Returns one item per page. The next_cursor field holds the cursor for the following page; an empty value signals the last page.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "format": "int64"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "metadata": {
                                            "type": "object",
                                            "properties": {
                                                "next_cursor": {
                                                    "type": "string",
                                                    "description": "Cursor for the next page; empty if this is the last page."
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "parameters": [
                {
                    "name": "cursor",
                    "in": "query",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "per_page",
                    "in": "query",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        },
        "/items/all": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Returns all items in a single response with no pagination parameters, used to verify that the NEXT_FIELD_CURSOR strategy does not interfere.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "integer",
                                                "format": "int64"
                                            },
                                            "name": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
