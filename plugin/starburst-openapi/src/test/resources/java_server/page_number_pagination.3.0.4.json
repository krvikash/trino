{
    "openapi": "3.0.4",
    "info": {
        "title": "Metadata Next URL Cursor Pagination API",
        "version": 1.0,
        "description": "Specification for testing the METADATA_NEXT_URL_CURSOR pagination strategy. The URL for the next page is embedded as a field in the JSON response body."
    },
    "paths": {
        "/items/paged": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Returns a page of items alongside the absolute URL for the next page. An empty next_url signals the last page.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "format": "int64"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "metadata": {
                                            "type": "object",
                                            "properties": {
                                                "isLastPage": {
                                                    "type": "boolean"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "parameters": [
                {
                    "name": "page",
                    "in": "query",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "name": "per_page",
                    "in": "query",
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        },
        "/items/all": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Returns all items in a single response. The response is a plain array with no isLastPage field, so the PAGE_NUMBER strategy does not activate.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "integer",
                                                "format": "int64"
                                            },
                                            "name": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/items/empty": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Always returns an empty items list, used to verify pagination handles zero results correctly.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "format": "int64"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "metadata": {
                                            "type": "object",
                                            "properties": {
                                                "isLastPage": {
                                                    "type": "boolean"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "parameters": [
                {
                    "name": "page",
                    "in": "query",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "name": "per_page",
                    "in": "query",
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        }
    }
}
