{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "structural_datatypes_json",
  "description": "A structural json schema for product tests",
  "type": "object",
  "properties": {
    "a_array": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": { "type": "string"}
        }
      ]
    },
    "a_object": {
      "oneOf": [
        { "type": "null" },
        {
            "type": "object",
            "properties": {
                "arr_int": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                    }
                },
                "ns": {"type": "string"}
            }
        }
      ]
    }
  },
  "additionalProperties": false
}
