{
    "type": "record",
    "name": "BillingSEPHeartbeatEvent",
    "namespace": "com.starburstdata.presto.eventbus",
    "version": "1.0",
    "doc": "Per-node Starburst Enterprise (SEP) usage heartbeat, emitted on a fixed interval by every coordinator and worker for billing. The CloudEvents context attributes (id, source, type, time) are promoted into the payload so they become columns in the Iceberg table that Galaxy Icehouse builds from the Kafka message value.",
    "fields": [
        {
            "name": "id",
            "type": "string",
            "doc": "CloudEvents id: producer-generated UUID."
        },
        {
            "name": "source",
            "type": "string",
            "doc": "CloudEvents source."
        },
        {
            "name": "type",
            "type": "string",
            "default": "SEP_HEARTBEAT",
            "doc": "CloudEvents type discriminator."
        },
        {
            "name": "time",
            "type": {"type": "long", "logicalType": "timestamp-millis"},
            "doc": "CloudEvents time: billing-sample instant, epoch millis UTC. Typed timestamp-millis so Icehouse maps it to an Iceberg timestamp for day()/month() partitioning. Primary partition and aggregation column."
        },
        {
            "name": "accountid",
            "type": ["null", "string"],
            "default": null,
            "doc": "Starburst account id of the enterprise customer; primary tenant key for billing aggregation. Receiver-populated: the telemetry ingest server resolves it from license/registration and stamps it before Kafka, so the producer leaves it null."
        },
        {
            "name": "durationmillis",
            "type": "long",
            "doc": "Length of the interval this heartbeat accounts for, in milliseconds."
        },
        {
            "name": "nodeenvironment",
            "type": ["null", "string"],
            "default": null,
            "doc": "SEP node environment name."
        },
        {
            "name": "instanceid",
            "type": ["null", "string"],
            "default": null,
            "doc": "Per-node SEP instance UUID, regenerated on process restart. Identifies a node epoch for diffing the cumulative CPU counters."
        },
        {
            "name": "nodeversion",
            "type": ["null", "string"],
            "default": null,
            "doc": "SEP/Trino version string."
        },
        {
            "name": "role",
            "type": ["null", "string"],
            "default": null,
            "doc": "Node role: 'coordinator' or 'worker'."
        },
        {
            "name": "starttime",
            "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
            "default": null,
            "doc": "Node process start instant, epoch millis UTC."
        },
        {
            "name": "cores",
            "type": ["null", "int"],
            "default": null,
            "doc": "CPU cores available to this node during the interval."
        },
        {
            "name": "cumulativecputime",
            "type": ["null", "double"],
            "default": null,
            "doc": "Cumulative process CPU time on this node since process start, in seconds. Matches legacy ClusterUsage.cumulativeCpuTime."
        },
        {
            "name": "cumulativeavailablecputime",
            "type": ["null", "double"],
            "default": null,
            "doc": "Cumulative available CPU time (elapsed wall-clock multiplied by cores) since process start, in seconds. Matches legacy ClusterUsage.cumulativeAvailableCpuTime."
        },
        {
            "name": "licenseowner",
            "type": ["null", "string"],
            "default": null,
            "doc": "SEP license owner."
        },
        {
            "name": "licensetype",
            "type": ["null", "string"],
            "default": null,
            "doc": "SEP license type, e.g. 'AWS_EKS'."
        },
        {
            "name": "licensehash",
            "type": ["null", "string"],
            "default": null,
            "doc": "Stable hash of the SEP license, for attribution."
        }
    ]
}
